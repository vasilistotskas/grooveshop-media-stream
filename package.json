{
  "name": "grooveshop-media-stream",
  "version": "3.2.0",
  "type": "module",
  "description": "Grooveshop Media Stream",
  "repository": {
    "type": "git",
    "url": "https://github.com/vasilistotskas/grooveshop-media-stream.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vasilistotskas/grooveshop-media-stream/issues"
  },
  "homepage": "https://github.com/vasilistotskas/grooveshop-media-stream#readme",
  "files": [
    "build/dist/**/*"
  ],
  "imports": {
    "#microservice/*": {
      "types": "./src/MediaStream/*.ts",
      "default": "./build/dist/MediaStream/*.js"
    }
  },
  "scripts": {
    "prebuild": "rimraf build/dist",
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "prod": "node build/dist/main",
    "repl": "nest start --watch --entryFile repl",
    "lint": "eslint . --fix",
    "lint:ci": "eslint .",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "type-check:watch": "tsc --noEmit --watch",
    "test": "vitest run",
    "test:e2e": "vitest run --config src/test/vitest.e2e.ts",
    "test:perf": "vitest run --config src/test/vitest.perf.ts",
    "test:coverage": "vitest run --coverage",
    "cache:clear": "node scripts/clear-cache.cjs",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@nestjs/axios": "12.0.1",
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/terminus": "12.0.0",
    "axios": "1.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "cron": "4.4.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "isomorphic-dompurify": "^4.2.0",
    "node-cache": "5.1.2",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@nestjs/cli": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@swc/core": "1.16.2",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.10.0",
    "rimraf": "6.1.3",
    "semantic-release": "25.0.9",
    "supertest": "7.2.2",
    "typescript": "7.0.2",
    "unplugin-swc": "1.6.0",
    "vitest": "5.0.1"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "npmPublish": false
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ],
          "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.12.0"
  }
}
