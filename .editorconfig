# editorconfig.org
root = true

[*]
indent_size = 2
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# ESLint (@antfu/eslint-config) enforces tabs in source
[*.{ts,js,mjs,cjs}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
