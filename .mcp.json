{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.0.4"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "redis": {
      "command": "uvx",
      "args": [
        "--from",
        "redis-mcp-server==0.5.1",
        "redis-mcp-server",
        "--url",
        "${REDIS_URL:-redis://localhost:6379/0}"
      ]
    }
  }
}
