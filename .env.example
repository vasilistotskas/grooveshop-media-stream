# Server Configuration
# NODE_ENV and LOG_LEVEL are the only settings read straight from the environment;
# everything else maps to a key in APP_CONFIG_SCHEMA (config-schema.util.ts).
NODE_ENV=development
# error | warn | info | debug | verbose
LOG_LEVEL=info
PORT=3003
HOST=0.0.0.0

# CORS Configuration
# Comma-separated PLATFORM origins (scheme://host[:port]). Store origins are
# admitted per request from the tenant-domain feed, never listed here.
# In production CORS_ORIGIN MUST be set explicitly (startup fails otherwise).
CORS_ORIGIN=*
CORS_METHODS=GET
CORS_MAX_AGE=86400

# Memory Cache Configuration
CACHE_MEMORY_MAX_SIZE=104857600
# Seconds, for writes that pass no TTL (image entries use CACHE_IMAGE_PRIVATE_TTL)
CACHE_MEMORY_DEFAULT_TTL=3600
CACHE_MEMORY_CHECK_PERIOD=600
CACHE_MEMORY_MAX_KEYS=1000
CACHE_MEMORY_WARNING_THRESHOLD=80

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Seconds, for writes that pass no TTL (image entries use CACHE_IMAGE_PRIVATE_TTL)
REDIS_TTL=7200
REDIS_MAX_RETRIES=3
# TTL (ms) for memoising the Redis health probe result
REDIS_HEALTH_CACHE_TTL=10000

# Scratch directory: source downloads in flight and the fallback image's renditions
CACHE_FILE_DIRECTORY=./storage

# Image Cache TTLs (seconds)
CACHE_IMAGE_PUBLIC_TTL=31104000
CACHE_IMAGE_PRIVATE_TTL=15552000
# Negative-cache TTL — suppresses retries for failed upstream fetches
CACHE_IMAGE_NEGATIVE_TTL=300

# Processing Configuration
# Container CPU limit used to derive Sharp concurrency (fractions allowed)
PROCESSING_CPU_CORES=1.5
# Admission control for Sharp pipelines: concurrent pipelines (0 = ceil of PROCESSING_CPU_CORES),
# how many requests may wait for a slot and for how long (beyond either → 503 + Retry-After),
# and the per-pipeline Sharp timeout in seconds (0 disables)
PROCESSING_MAX_CONCURRENT=0
PROCESSING_MAX_QUEUE=16
PROCESSING_QUEUE_TIMEOUT_MS=10000
PROCESSING_TIMEOUT_SECONDS=20
# AVIF quality ceiling (1-100); a lower requested quality still wins. The request
# is clamped before its cache identity is hashed, so changing this re-keys AVIF only.
PROCESSING_AVIF_MAX_QUALITY=55

# Monitoring Configuration
MONITORING_ENABLED=true
MONITORING_SYSTEM_METRICS_INTERVAL=60000
MONITORING_PERFORMANCE_METRICS_INTERVAL=30000
# Bearer token for GET /metrics (Authorization: Bearer <token>). Read-only and
# separate from INTERNAL_ADMIN_SECRET. Unset keeps /metrics closed (401).
METRICS_BEARER_TOKEN=

# Image Source URLs
BACKEND_URL=http://localhost:8000

# HTTP Client Configuration
HTTP_TIMEOUT=30000
HTTP_MAX_RETRIES=3
HTTP_RETRY_DELAY=1000
HTTP_MAX_RETRY_DELAY=10000
HTTP_POOL_MAX_SOCKETS=50
HTTP_POOL_KEEP_ALIVE_MS=1000
HTTP_CIRCUIT_BREAKER_ENABLED=true
HTTP_CIRCUIT_BREAKER_FAILURE_THRESHOLD=50
HTTP_CIRCUIT_BREAKER_RESET_TIMEOUT=30000
HTTP_CIRCUIT_BREAKER_MONITORING_PERIOD=60000
HTTP_CIRCUIT_BREAKER_MINIMUM_REQUESTS=10
# Comma-separated upstream URLs probed by the HTTP health indicator (empty disables probing)
HTTP_HEALTH_CHECK_URLS=
HTTP_HEALTH_CHECK_TIMEOUT=5000

# Rate Limiting Configuration
# RATE_LIMIT_ENABLED=false is the kill-switch (use it for local development;
# there is no automatic skip in development mode).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_WINDOW_MS=60000
RATE_LIMIT_DEFAULT_MAX=100
RATE_LIMIT_IMAGE_PROCESSING_WINDOW_MS=60000
RATE_LIMIT_IMAGE_PROCESSING_MAX=50
RATE_LIMIT_HEALTH_CHECK_WINDOW_MS=10000
RATE_LIMIT_HEALTH_CHECK_MAX=1000
RATE_LIMIT_BYPASS_HEALTH_CHECKS=true
RATE_LIMIT_BYPASS_STATIC_ASSETS=true
# Comma-separated; an entry matches itself and its subdomains. Only honoured for internal-IP callers.
RATE_LIMIT_BYPASS_WHITELISTED_DOMAINS=
RATE_LIMIT_BYPASS_BOTS=true

# Input Validation Configuration
# Comma-separated hostnames allowed as upstream image sources. The built-in default is
# deployment-neutral (loopback + in-cluster Service names); public hostnames are deployment data.
VALIDATION_ALLOWED_DOMAINS=
VALIDATION_MAX_STRING_LENGTH=10000

# Dynamic tenant-domain allowlist (polled from Django's internal feed)
# Empty secret disables the feature entirely — VALIDATION_ALLOWED_DOMAINS above stays the baseline allowlist.
# X-Internal-Token header sent to Django must match this value.
INTERNAL_DOMAINS_SECRET=
# Defaults to {BACKEND_URL}/api/v1/tenant/internal/domains when unset
TENANT_DOMAINS_REFRESH_URL=
TENANT_DOMAINS_REFRESH_INTERVAL_MS=300000

# Rendition store: an S3-compatible bucket (Cloudflare R2) shared by every replica,
# behind the memory and Redis tiers. A call that takes longer than the timeout is
# a miss (read) or leaves the image uncached (write). Empty endpoint or bucket = off.
# R2 jurisdiction buckets need the jurisdiction endpoint:
# https://<ACCOUNT_ID>.eu.r2.cloudflarestorage.com
RENDITION_STORE_ENDPOINT=
RENDITION_STORE_BUCKET=
RENDITION_STORE_ACCESS_KEY_ID=
RENDITION_STORE_SECRET_ACCESS_KEY=
RENDITION_STORE_READ_TIMEOUT_MS=1000
RENDITION_STORE_WRITE_TIMEOUT_MS=5000

# Exact sizes, learned. A requested size becomes exact (no extra pixel) once the
# service rendered it for RENDITION_SIZES_MIN_SOURCES uploads, stays exact while it
# is asked for within RENDITION_SIZES_WINDOW_DAYS, and at most RENDITION_SIZES_MAX_KNOWN
# sizes are exact at once (the least recently asked leaves first). Any other size
# snaps up the width ladder.
RENDITION_SIZES_MIN_SOURCES=10
RENDITION_SIZES_WINDOW_DAYS=30
RENDITION_SIZES_MAX_KNOWN=300

# Rendition pre-generation (needs the store). The cron walks {RENDITIONS_MEDIA_DIRECTORY}/{tenant}/uploads,
# and for every upload that lacks them renders the renditions its folder is shown
# at, learned from the renditions already made (one made for at least
# RENDITIONS_MIN_SOURCES different sources of the folder, at most
# RENDITIONS_MAX_PER_SOURCE per source), using only capacity no request wants.
# Empty directory = off.
RENDITIONS_MEDIA_DIRECTORY=
RENDITIONS_CRON=*/10 * * * *
RENDITIONS_MIN_SOURCES=3
RENDITIONS_MAX_PER_SOURCE=16

# Graceful Shutdown
SHUTDOWN_TIMEOUT=30000
SHUTDOWN_FORCE_TIMEOUT=60000

# Internal admin secret — required for POST /admin/cache/flush-tenant and POST /health/circuit-breaker/reset.
# Leave unset in development (endpoints will return 401). Set a strong random value in production.
INTERNAL_ADMIN_SECRET=
